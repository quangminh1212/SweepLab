# Everything is text and normalised to LF so the repository behaves the same on
# Windows, Linux and macOS runners.
* text=auto eol=lf

*.ps1  text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

*.png binary
*.jpg binary
*.zip binary
*.nupkg binary
